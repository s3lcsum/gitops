# MQTT credentials for zigbee2mqtt (LAN listener on mosquitto).
# User must match /var/lib/hass/mosquitto.passwd on the Portainer host
# (uid 1883, mode 640 — not under /opt/hass; see mosquitto.conf comments).
ZIGBEE2MQTT_CONFIG_MQTT_USER=mqtt
ZIGBEE2MQTT_CONFIG_MQTT_PASSWORD=your-mqtt-password-here
