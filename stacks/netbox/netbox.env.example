# NetBox — copy to netbox.env and fill real values.
# DB user/password come from Vault static creds after terraform/postgres + terraform/vault apply.

DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=your-database-password-here

REDIS_HOST=netbox-redis

SKIP_SUPERUSER=true

SECRET_KEY=your-django-secret-key-here
API_TOKEN_PEPPERS=your-api-token-peppers-here

# OIDC SSO via Authentik
REMOTE_AUTH_ENABLED=true
REMOTE_AUTH_BACKEND=social_core.backends.open_id_connect.OpenIdConnectAuth
REMOTE_AUTH_AUTO_CREATE_USER=true
REMOTE_AUTH_AUTO_CREATE_GROUPS=true
REMOTE_AUTH_GROUP_SYNC_ENABLED=true
REMOTE_AUTH_SUPERUSER_GROUPS=admins
REMOTE_AUTH_DEFAULT_GROUPS=users
SOCIAL_AUTH_OIDC_OIDC_ENDPOINT=https://auth.dominiksiejak.pl/application/o/netbox/
SOCIAL_AUTH_OIDC_KEY=netbox
SOCIAL_AUTH_OIDC_SECRET=your-oidc-client-secret-here
SOCIAL_AUTH_OIDC_SCOPE=openid email profile
LOGOUT_REDIRECT_URL=https://auth.dominiksiejak.pl
