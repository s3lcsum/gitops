HOST=0.0.0.0
PORT=3333
ROOT_URL=https://ghostfolio.dominiksiejak.pl
TRUST_PROXY=1

# PostgreSQL (centralized postgres; provisioned via terraform/postgres + terraform/vault)
POSTGRES_DB=ghostfolio_db
POSTGRES_USER=ghostfolio_user
POSTGRES_PASSWORD=your-secure-database-password
DATABASE_URL=postgresql://ghostfolio_user:${POSTGRES_PASSWORD}@postgres:5432/ghostfolio_db

# Redis cache sidecar
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# Security
ACCESS_TOKEN_SALT=your-very-long-random-salt
JWT_SECRET_KEY=your-very-long-random-jwt-secret

# OIDC (Authentik, experimental feature)
ENABLE_FEATURE_AUTH_OIDC=true
OIDC_ISSUER=https://auth.dominiksiejak.pl/application/o/ghostfolio/
OIDC_CLIENT_ID=ghostfolio
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_CALLBACK_URL=https://ghostfolio.dominiksiejak.pl/api/auth/oidc/callback
OIDC_SCOPE=["email","openid","profile"]

# Optional data providers
# API_KEY_COINGECKO_DEMO=
# API_KEY_COINGECKO_PRO=
