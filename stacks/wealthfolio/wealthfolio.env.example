# Wealthfolio — copy to wealthfolio.env and fill real values.
WF_LISTEN_ADDR=0.0.0.0:8088
WF_DB_PATH=/data/wealthfolio.db
WF_SECRET_KEY=your-wf-secret-key-here
WF_CORS_ALLOW_ORIGINS=https://wealthfolio.dominiksiejak.pl
WF_COOKIE_SECURE=true

WF_OIDC_ISSUER_URL=https://auth.dominiksiejak.pl/application/o/wealthfolio/
WF_OIDC_CLIENT_ID=wealthfolio
WF_OIDC_CLIENT_SECRET=your-oidc-client-secret-here
WF_OIDC_REDIRECT_URL=https://wealthfolio.dominiksiejak.pl/api/v1/auth/oidc/callback
WF_OIDC_ALLOWED_SUBS=your-oidc-allowed-subs-here
