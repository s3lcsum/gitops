    {
      "id": "focus-on-plan",
      "name": "Plan Immediate On",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        -384
      ],
      "parameters": {
        "jsCode": "const route = $('Route Focus Event').first().json;\nconst row = $('Get Controller (Focus)').first().json;\nconst cur = $input.first().json;\nconst entry = cur && cur.id ? cur : (cur.data || null);\nconst has = !!(entry && entry.id);\nconst workspace_id = Number(route.workspace_id || 3825058);\nconst target = route.target || { project_id: Number(route.inpost_project_id || 215500877), description: 'Work' };\nconst project_id = Number(target.project_id);\nconst description = String(target.description || route.focus || 'Work');\nconst curPid = has ? Number(entry.project_id || 0) : 0;\nconst matches = has && curPid === project_id;\nconst need_stop = has && !matches;\n\n// Resume window: same project stopped < 5 minutes ago → one continuous entry\nconst RESUME_MS = 5 * 60 * 1000;\nconst lastStoppedAt = row.last_timer_stopped_at ? Date.parse(row.last_timer_stopped_at) : 0;\nconst lastPid = Number(row.last_timer_project_id || 0);\nconst lastEntryId = row.last_timer_entry_id ? String(row.last_timer_entry_id) : '';\nconst lastStart = row.last_timer_start ? String(row.last_timer_start) : '';\nconst canResume = !matches\n  && !!lastEntryId\n  && !!lastStart\n  && lastPid === project_id\n  && lastStoppedAt\n  && (Date.now() - lastStoppedAt) < RESUME_MS;\n\nconst need_resume = canResume;\nconst need_start = !matches;\nconst start_iso = need_resume ? lastStart : new Date().toISOString();\n\n// When stopping a different running timer (e.g. Work→Fitness), remember it for resume\nconst remember_stop = need_stop;\nconst remember_entry_id = remember_stop ? String(entry.id) : null;\nconst remember_start = remember_stop ? String(entry.start || '') : null;\nconst remember_project_id = remember_stop ? curPid : null;\nconst remember_description = remember_stop ? String(entry.description || '') : null;\n\nreturn [{ json: {\n  desired: true,\n  need_stop,\n  need_start,\n  need_resume,\n  need_focus: !!route.need_focus,\n  shortcut: route.shortcut || 'Set Work Focus',\n  stop_id: need_stop ? entry.id : null,\n  stop_wid: need_stop ? (entry.workspace_id || workspace_id) : null,\n  workspace_id,\n  project_id,\n  description,\n  start_iso,\n  resume_delete_id: need_resume ? lastEntryId : null,\n  remember_stop,\n  remember_entry_id,\n  remember_start,\n  remember_project_id,\n  remember_description,\n  inpost_project_id: Number(route.inpost_project_id || 215500877),\n  focus: route.focus,\n  suppress_until: new Date(Date.now() + 120000).toISOString(),\n  suppress_focus_until: route.need_focus\n    ? new Date(Date.now() + 120000).toISOString()\n    : (row.suppress_focus_until || null),\n  notes: `focus on focus=${route.focus} project=${project_id} stop=${need_stop} start=${need_start} resume=${need_resume} need_focus=${!!route.need_focus}`\n}}];"
      }
    },
