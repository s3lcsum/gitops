      "parameters": {
        "jsCode": "const route = $('Route Focus Event').first().json;\nconst row = $('Get Controller (Focus)').first().json;\nconst cur = $input.first().json;\nconst entry = cur && cur.id ? cur : (cur.data || null);\nconst has = !!(entry && entry.id);\nconst workspace_id = Number(route.workspace_id || 3825058);\nconst need_stop = has;\nreturn [{ json: {\n  desired: false,\n  need_stop,\n  need_focus: !!route.need_focus,\n  shortcut: 'Clear Work Focus',\n  stop_id: need_stop ? entry.id : null,\n  stop_wid: need_stop ? (entry.workspace_id || workspace_id) : null,\n  workspace_id,\n  // Remember stopped entry for 5-min resume window\n  remember_entry_id: need_stop ? String(entry.id) : '',\n  remember_start: need_stop ? String(entry.start || '') : '',\n  remember_project_id: need_stop ? Number(entry.project_id || 0) : null,\n  remember_description: need_stop ? String(entry.description || '') : '',\n  inpost_project_id: Number(route.inpost_project_id || 215500877),\n  focus: route.focus,\n  suppress_until: need_stop\n    ? new Date(Date.now() + 120000).toISOString()\n    : (row.suppress_toggl_until || null),\n  suppress_focus_until: route.need_focus\n    ? new Date(Date.now() + 120000).toISOString()\n    : (row.suppress_focus_until || null),\n  notes: `focus off focus=${route.focus} stop=${need_stop} need_focus=${!!route.need_focus}`\n}}];"
