        "jsCode": "const body = $input.first().json.body || {};\n// Shortcuts POST only {\"focus\":\"<name>\"}; \"\" = Focus off. No state field.\n// Only Work + Fitness start Toggl timers; everything else stops any running timer.\nconst focus = String(body.focus ?? '').trim();\nconst FOCUS_TIMERS = {\n  Work: { project_id: 215500877, description: 'Work' },\n  Fitness: { project_id: 222326897, description: 'Fitness' },\n};\nconst target = FOCUS_TIMERS[focus] || null;\nconst desired = target ? 'on' : 'off';\nreturn [{ json: { desired, focus, target, received_at: new Date().toISOString(), source: 'focus' } }];"
