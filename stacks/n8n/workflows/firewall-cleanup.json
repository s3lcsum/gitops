    {
      "id": "filter-expired",
      "name": "Filter Expired",
      "parameters": {
        "jsCode": "const listName = String($vars.ROUTEROS_ADDRESS_LIST);\nconst now = Date.now();\nconst entries = $input.all().map(i => i.json);\n\nconst expired = entries\n  .filter(e => {\n    if (e.list !== listName) return false;\n    const m = (e.comment || '').match(/^ttl:(\\d+)$/);\n    return m && Number(m[1]) < now;\n  })\n  .map(e => ({\n    json: {\n      id: e['.id'],\n      address: e.address,\n      comment: e.comment\n    }\n  }));\n\nreturn expired;",
        "mode": "runOnceForAllItems"
      },
      "position": [
        500,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
