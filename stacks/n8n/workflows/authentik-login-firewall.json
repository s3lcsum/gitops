{
  "id": "w72dTPBXqHZKN1ip",
  "name": "Add IP to Firewall on Authentik login",
  "active": true,
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "parameters": {
        "httpMethod": "POST",
        "options": {},
        "path": "authentik-login",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "position": [
        200,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "63c51090-87d9-4f00-9c18-eec357240fba",
      "credentials": {
        "httpHeaderAuth": {
          "id": "58suiQVjjFvERDku",
          "name": "wan-allowlist"
        }
      }
    },
    {
      "id": "check-login-event",
      "name": "Check Login Event",
      "parameters": {
        "conditions": {
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.body.event?.action || $json.body.action }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "login"
            },
            {
              "leftValue": "={{ $json.body.event?.action || $json.body.action }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "authorize_application"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        640,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "compute-expiry",
      "name": "Compute Expiry",
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst event = body.event && typeof body.event === 'object' ? body.event : body;\nconst ip = String(event.client_ip || body.client_ip || '').trim();\nconst user = event.user?.username || event.user?.name || body.user?.username || 'unknown';\nconst ttlMs = 7 * 24 * 60 * 60 * 1000;\nconst now = Date.now();\nconst expiresMs = now + ttlMs;\nconst apiUrl = 'http://192.168.89.1/rest/ip/firewall/address-list/add';\nreturn [{ json: { ip, user, expires_ms: expiresMs, expires_iso: new Date(expiresMs).toISOString(), api_url: apiUrl } }];"
      },
      "position": [
        860,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "validate-ip",
      "name": "Validate IP",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.ip }}",
              "operator": {
                "operation": "regex",
                "type": "string"
              },
              "rightValue": "^(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)$"
            },
            {
              "leftValue": "={{ $json.ip }}",
              "operator": {
                "operation": "notEquals",
                "type": "string"
              },
              "rightValue": "0.0.0.0"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        1080,
        200
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "put-routeros",
      "name": "PUT to RouterOS",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "jsonBody": "={ \"address\": \"{{ $json.ip }}\", \"list\": \"allowed-wan\", \"comment\": \"ttl:{{ $json.expires_ms }}\", \"disabled\": false }",
        "method": "POST",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "={{ $json.api_url }}"
      },
      "position": [
        1740,
        120
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpBasicAuth": {
          "id": "eTkZPZyTIeqFEZyR",
          "name": "RouterOS n8n-admin"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "classify-add",
      "name": "Classify Add Result",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json || {};\nconst detail = String(body.detail || '');\nconst duplicate = detail.includes('already have such entry');\nconst created = Boolean(body.ret);\nconst src = $('Compute Expiry').first().json;\nconst route = duplicate ? 'duplicate' : (created ? 'created' : 'error');\nreturn [{ json: { route, ip: src.ip, user: src.user, expires_ms: src.expires_ms, expires_iso: src.expires_iso } }];"
      },
      "position": [
        1960,
        40
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "is-duplicate",
      "name": "Is Duplicate",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.route }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "duplicate"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        2180,
        40
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "add-ok",
      "name": "Add Created",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.route }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "created"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        2400,
        220
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "get-address-list",
      "name": "GET Address List",
      "onError": "continueErrorOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "method": "GET",
        "options": {},
        "url": "http://192.168.89.1/rest/ip/firewall/address-list"
      },
      "position": [
        2400,
        -80
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpBasicAuth": {
          "id": "eTkZPZyTIeqFEZyR",
          "name": "RouterOS n8n-admin"
        }
      }
    },
    {
      "id": "find-entry",
      "name": "Find Existing Entry",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = $('Compute Expiry').first().json;\nconst ip = String(src.ip);\nconst entries = $input.all().map(i => i.json);\nconst hit = entries.find(e => {\n  if (!e || e.list !== 'allowed-wan' || !e['.id']) return false;\n  const address = String(e.address || '');\n  return address === ip || address === ip + '/32';\n});\nif (!hit) return [{ json: { found: 'no', ip } }];\nreturn [{ json: { found: 'yes', id: hit['.id'], comment: 'ttl:' + String(src.expires_ms), ip } }];"
      },
      "position": [
        2620,
        -80
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "entry-found",
      "name": "Entry Found",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "yes"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        2840,
        -80
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "update-ttl",
      "name": "Update TTL",
      "onError": "continueErrorOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "jsonBody": "={ \".id\": \"{{ $json.id }}\", \"comment\": \"{{ $json.comment }}\" }",
        "method": "POST",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://192.168.89.1/rest/ip/firewall/address-list/set"
      },
      "position": [
        3060,
        -160
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpBasicAuth": {
          "id": "eTkZPZyTIeqFEZyR",
          "name": "RouterOS n8n-admin"
        }
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"ip\": \"{{ $node[\"Compute Expiry\"].json.ip }}\", \"user\": \"{{ $node[\"Compute Expiry\"].json.user }}\", \"expires\": \"{{ $node[\"Compute Expiry\"].json.expires_iso }}\" }"
      },
      "position": [
        3280,
