{
  "id": "w72dTPBXqHZKN1ip",
  "name": "WAN allowlist on login",
  "active": true,
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "parameters": {
        "httpMethod": "POST",
        "options": {},
        "path": "authentik-login",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "position": [
        200,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "63c51090-87d9-4f00-9c18-eec357240fba",
      "credentials": {
        "httpHeaderAuth": {
          "id": "58suiQVjjFvERDku",
          "name": "wan-allowlist"
        }
      }
    },
    {
      "id": "check-login-event",
      "name": "Check Login Event",
      "parameters": {
        "conditions": {
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.body.event?.action || $json.body.action }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "login"
            },
            {
              "leftValue": "={{ $json.body.event?.action || $json.body.action }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "authorize_application"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        640,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "compute-expiry",
      "name": "Compute Expiry",
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst event = body.event && typeof body.event === 'object' ? body.event : body;\nconst ip = String(event.client_ip || body.client_ip || '').trim();\nconst user = event.user?.username || event.user?.name || body.user?.username || 'unknown';\nconst ttlMs = Number($vars.WAN_ALLOWLIST_TTL_MS);\nconst listName = String($vars.ROUTEROS_ADDRESS_LIST);\nconst apiUrl = String($vars.ROUTEROS_API_URL).replace(/\\/$/, '') + '/ip/firewall/address-list/add';\nconst now = Date.now();\nconst expiresMs = now + ttlMs;\nreturn [{ json: { ip, user, expires_ms: expiresMs, expires_iso: new Date(expiresMs).toISOString(), api_url: apiUrl, list_name: listName } }];"
      },
      "position": [
        860,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "validate-ip",
      "name": "Validate IP",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.ip }}",
              "operator": {
                "operation": "regex",
                "type": "string"
              },
              "rightValue": "^(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)$"
            },
            {
              "leftValue": "={{ $json.ip }}",
              "operator": {
                "operation": "notEquals",
                "type": "string"
              },
              "rightValue": "0.0.0.0"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        1080,
        200
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "put-routeros",
      "name": "PUT to RouterOS",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "jsonBody": "={ \"address\": \"{{ $json.ip }}\", \"list\": \"{{ $json.list_name }}\", \"comment\": \"ttl:{{ $json.expires_ms }}\", \"disabled\": false }",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "={{ $json.api_url }}"
      },
      "position": [
        1740,
        120
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpBasicAuth": {
          "id": "eTkZPZyTIeqFEZyR",
          "name": "RouterOS n8n-admin"
        }
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"ip\": \"{{ $node[\"Compute Expiry\"].json.ip }}\", \"user\": \"{{ $node[\"Compute Expiry\"].json.user }}\", \"expires\": \"{{ $node[\"Compute Expiry\"].json.expires_iso }}\" }"
      },
      "position": [
        1960,
        120
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-not-login",
      "name": "Respond Not Login",
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"skipped\": true }"
      },
      "position": [
        860,
        450
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-bad-ip",
      "name": "Respond Bad IP",
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"invalid ip\" }"
      },
      "position": [
        1300,
        360
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
      "parameters": {
        "options": {
          "responseCode": 500
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"router error\" }"
      },
      "position": [
        1960,
        360
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "index": 0,
            "node": "Check Login Event",
            "type": "main"
          }
        ]
      ]
    },
    "Check Login Event": {
      "main": [
        [
          {
            "index": 0,
            "node": "Compute Expiry",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Respond Not Login",
            "type": "main"
          }
        ]
      ]
    },
    "Compute Expiry": {
      "main": [
        [
          {
            "index": 0,
            "node": "Validate IP",
            "type": "main"
          }
        ]
      ]
    },
    "Validate IP": {
      "main": [
        [
          {
            "index": 0,
            "node": "PUT to RouterOS",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Respond Bad IP",
            "type": "main"
          }
        ]
      ]
    },
    "PUT to RouterOS": {
      "main": [
        [
          {
            "index": 0,
            "node": "Respond Success",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Respond Error",
            "type": "main"
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
