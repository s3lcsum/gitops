  },
  "name": "firewall-add",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "parameters": {
        "httpMethod": "POST",
        "options": {},
        "path": "firewall",
        "responseMode": "responseNode"
      },
      "position": [
        200,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2
    },
    {
      "id": "auth-check",
      "name": "Auth Check",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.headers[\"x-authentik-uid\"] }}",
              "operator": {
                "operation": "exists",
                "singleValue": true,
                "type": "string"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        420,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "validate-ip",
      "name": "Validate IP",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ /^(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)$/.test($json.body.ip) }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        640,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "compute-expiry",
      "name": "Compute Expiry",
      "parameters": {
        "jsCode": "const ip = $input.first().json.body.ip;\nconst ttl = $input.first().json.body.ttl;\n\nconst ttlMap = { '1d': 86400000, '7d': 604800000, '30d': 2592000000 };\nconst ms = ttlMap[ttl];\nif (!ms) {\n  throw new Error('Invalid TTL: must be 1d, 7d, or 30d');\n}\n\nconst now = Date.now();\nconst expiresMs = now + ms;\nconst expiresIso = new Date(expiresMs).toISOString();\n\nreturn [{\n  json: {\n    ip,\n    ttl,\n    expires_ms: expiresMs,\n    expires_iso: expiresIso,\n    headers: $input.first().json.headers,\n    body: $input.first().json.body\n  }\n}];"
      },
      "position": [
        860,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "compute-auth",
      "name": "Compute Auth",
      "parameters": {
        "jsCode": "const user = $env.ROUTEROS_API_USER;\nconst pass = $env.ROUTEROS_API_PASS;\nconst auth = Buffer.from(user + ':' + pass).toString('base64');\n\nconst prev = $input.first().json;\nreturn [{\n  json: {\n    ...prev,\n    auth_header: 'Basic ' + auth\n  }\n}];"
      },
      "position": [
        1080,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "put-routeros",
      "name": "PUT to RouterOS",
      "parameters": {
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.auth_header }}"
            }
          ]
        },
        "jsonBody": "={ \"address\": \"{{ $json.ip }}\", \"list\": \"allowed-wan\", \"comment\": \"ttl:{{ $json.expires_ms }}\", \"disabled\": false }",
        "method": "PUT",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "url": "={{ $env.ROUTEROS_API_URL }}/ip/firewall/address-list"
      },
      "position": [
        1300,
        200
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"ip\": \"{{ $json.ip }}\", \"expires\": \"{{ $json.expires_iso }}\", \"detail\": \"Added to allowed-wan until {{ $json.expires_iso }}\" }"
      },
      "position": [
        1520,
        200
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-auth-fail",
      "name": "Respond Auth Fail",
      "parameters": {
        "options": {
          "responseCode": 403
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"Unauthenticated\" }"
      },
      "position": [
        640,
        500
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-ip-fail",
      "name": "Respond IP Fail",
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"Invalid IP\" }"
      },
      "position": [
        860,
        450
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
      "parameters": {
        "options": {
          "responseCode": 500
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"Router error: {{ $json.error?.statusCode || 'unknown' }}\" }"
      },
      "position": [
        1520,
        400
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    }
  ],
  "settings": {
    "executionOrder": "v1"
  }
}
