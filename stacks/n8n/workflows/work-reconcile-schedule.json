          "value": {
            "work_active": "={{ $json.work_active }}",
            "last_source": "={{ $json.last_source }}",
            "last_event_at": "={{ $json.last_event_at }}",
            "last_inpost_entry_id": "={{ $json.last_inpost_entry_id }}",
