    {
      "id": "b511ced5-1776-5071-a9ae-2f2a4be9c8c8",
      "name": "Plan Calendar Diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        200
      ],
      "parameters": {
        "jsCode": "const window=$('Compute Window').first().json;\nconst entriesRaw=$('Fetch Toggl Entries').all().map(i=>i.json);\nconst entries=entriesRaw.flatMap(e=>Array.isArray(e)?e:[e]).filter(e=>e && e.id);\nconst projectsRaw=$('Fetch Toggl Projects').all().map(i=>i.json);\nconst projects=projectsRaw.flatMap(p=>Array.isArray(p)?p:[p]);\nconst projectName={};\nfor (const p of projects) if (p && p.id) projectName[p.id]=p.name || 'No Project';\nconst gcalRaw=$('List Calendar Events').all().map(i=>i.json);\nconst events=gcalRaw.filter(e=>e && e.id);\nconst mappingsRaw=$('Get Calendar Mappings').all().map(i=>i.json);\nconst mappings=mappingsRaw.filter(m=>m && m.toggl_entry_id && m.google_event_id);\nconst byToggl={};\nfor (const ev of events) {\n  let tid=(ev.extendedProperties && ev.extendedProperties.private && ev.extendedProperties.private.toggl_entry_id) || null;\n  if (!tid && typeof ev.description === 'string') {\n    const m = ev.description.match(/\\[toggl:(\\d+)\\]/);\n    if (m) tid = m[1];\n  }\n  if (tid) byToggl[String(tid)]=ev;\n}\nfor (const m of mappings) {\n  const tid = String(m.toggl_entry_id);\n  if (!byToggl[tid]) byToggl[tid] = { id: m.google_event_id, _from_mapping: true };\n}\nconst syncNow=new Date(window.sync_now);\nconst desired=[];\nfor (const e of entries) {\n  const start=e.start; let end=e.stop;\n  const running = Number(e.duration) < 0 || !e.stop;\n  if (running) end = syncNow.toISOString();\n  if (!start || !end) continue;\n  const pname = e.project_id ? (projectName[e.project_id] || 'Project') : 'No Project';\n  const desc = (e.description || '').trim();\n  const title = desc ? `${pname} \u2014 ${desc}` : pname;\n  desired.push({\n    toggl_entry_id: String(e.id),\n    title,\n    start_iso: start,\n    end_iso: end,\n    project_id: e.project_id || null,\n    project_name: pname,\n    description: desc,\n    workspace_id: e.workspace_id || 3825058,\n    is_running: running,\n    canonical: {title, start, end, project_id: e.project_id || null, description: desc}\n  });\n}\nconst desiredIds=new Set(desired.map(d=>d.toggl_entry_id));\nconst actions=[];\nconst queueDelete = (tid, gid, source) => {\n  if (!gid || desiredIds.has(tid)) return;\n  if (actions.some(a => a.op === 'delete' && a.toggl_entry_id === tid)) return;\n  actions.push({ op: 'delete', toggl_entry_id: tid, google_event_id: gid, source, calendar_id: window.calendar_id, sync_now: window.sync_now });\n};\nfor (const d of desired) {\n  const existing=byToggl[d.toggl_entry_id];\n  if (!existing) {\n    actions.push({op:'create', ...d});\n    continue;\n  }\n  if (existing._from_mapping) {\n    actions.push({op:'update', google_event_id: existing.id, ...d});\n    continue;\n  }\n  const norm=(v)=>{ try { return new Date(v).toISOString(); } catch(e) { return String(v||''); } };\n  const sameTitle=(existing.summary||'')===d.title;\n  const sameStart=norm(existing.start && (existing.start.dateTime||existing.start.date))===norm(d.start_iso);\n  const sameEnd=norm(existing.end && (existing.end.dateTime||existing.end.date))===norm(d.end_iso);\n  if (!sameTitle || !sameStart || !sameEnd) {\n    actions.push({op:'update', google_event_id: existing.id, ...d});\n  } else {\n    actions.push({op:'noop', google_event_id: existing.id, ...d});\n  }\n}\nfor (const m of mappings) {\n  queueDelete(String(m.toggl_entry_id), m.google_event_id, 'mapping');\n}\nfor (const [tid, ev] of Object.entries(byToggl)) {\n  if (ev._from_mapping) continue;\n  queueDelete(tid, ev.id, 'calendar');\n}\nreturn actions.map(a=>({json:a}));"
      }
    },
