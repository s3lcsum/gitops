    {
      "id": "8bf7af15-4efa-5e71-ae31-249df463794b",
      "name": "Compute Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        80
      ],
      "parameters": {
        "jsCode": "const meta=$input.first().json;\nconst now=new Date();\nconst start=new Date(now.getTime()-30*24*60*60*1000);\nreturn [{json:{\n  calendar_id: meta.calendar_id || '8c8fc35e0478c9bf6e2a7f86f29b90448a0f81ff59854727d20efbfa7a93cdb7@group.calendar.google.com',\n  timeMin: start.toISOString(),\n  timeMax: now.toISOString(),\n  sync_now: now.toISOString(),\n  backfill_done: !!meta.backfill_done,\n  meta_id: meta.id\n}}];"
      }
    },
