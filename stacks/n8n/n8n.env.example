n8n_encryption_key=your_encryption_key_here
N8N_API_ENABLED=false

db_type=postgresdb
db_postgresdb_host=postgres
db_postgresdb_user=your_user_here
db_postgresdb_password=your_password_here
db_postgresdb_database=your_database_here

# Telegram Configuration
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GCP Service Account Configuration
GOOGLE_APPLICATION_CREDENTIALS_JSON=your_gcp_service_account_json_here

# OpenAI Configuration (if not already set in n8n UI)
OPENAI_API_KEY=your_openai_api_key_here

# RouterOS REST auth leftovers (optional / legacy). Firewall workflows do NOT read
# these via $env (N8N_BLOCK_ENV_ACCESS_IN_NODE=true). Auth = n8n credential
# "RouterOS n8n-admin". Non-secret config = n8n Variables ($vars) from
# stacks/n8n/variables.json: ROUTEROS_API_URL, ROUTEROS_ADDRESS_LIST,
# WAN_ALLOWLIST_TTL_MS. Do not hairpin through https://router.dominiksiejak.pl.
ROUTEROS_API_USER=your_routeros_api_user_here
ROUTEROS_API_PASS=your_routeros_api_password_here

# Webhook static keys. Header name is x-webhook-secret.
# Values live only in /opt/n8n/n8n.env and in the matching n8n headerAuth credential.
WAN_ALLOWLIST_SECRET=your_webhook_secret_here
FOCUS_TOGGL_SECRET=your_webhook_secret_here
TOGGL_CALENDAR_SECRET=your_webhook_secret_here
TOGGL_WEBHOOK_SECRET=your_toggl_webhook_hmac_secret_here

# Toggl ids. Real values stay in /opt/n8n/n8n.env.
TOGGL_INPOST_PROJECT_NAME=InPost
TOGGL_WORKSPACE_ID=your_toggl_workspace_id_here
TOGGL_INPOST_PROJECT_ID=your_toggl_inpost_project_id_here
TOGGL_CALENDAR_ID=your_google_toggl_calendar_id_here
