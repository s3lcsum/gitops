# Encryption / auth (generate fresh values — losing ENCRYPTION_KEY means losing secrets)
#   openssl rand -hex 16
ENCRYPTION_KEY=replace-with-openssl-rand-hex-16
#   openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# PostgreSQL (centralized postgres; provisioned via terraform/postgres + terraform/vault)
# Password from: vault read database/static-creds/infisical_user
DB_CONNECTION_URI=postgresql://infisical_user:your-secure-database-password@postgres:5432/infisical_db

# Redis sidecar (same password used by compose redis --requirepass)
# Host must be `infisical-redis`, not `redis`: gf-redis (ghostfolio) also claims the
# `redis` alias on the shared `database` network, and since this service is on that
# network too, plain `redis` resolves to ghostfolio's instance and auth fails.
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@infisical-redis:6379

# Optional SMTP (invites / password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=infisical@dominiksiejak.pl
# SMTP_FROM_NAME=Infisical
