CF_DNS_API_TOKEN=your-cloudflare-dns-api-token-here
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id-here

# Generated by CrowdSec: cscli bouncers add traefik-bouncer
CROWDSEC_API_KEY=your-crowdsec-bouncer-api-key-here

# Basic credential for the upstream opencode server (OPENCODE_SERVER_PASSWORD).
# Traefik injects it in opencode-upstream-auth so the browser is never prompted;
# edge auth for opencode.dominiksiejak.pl is Authentik forward-auth.
#   printf 'opencode:the-password' | base64
OPENCODE_UPSTREAM_BASIC=b3BlbmNvZGU6cmVwbGFjZS13aXRoLXlvdXItYmFzZTY0


# Envoy Gateway (MetalLB) host:port for argocd.lake → HTTP listener; verify: kubectl get svc -n envoy-gateway-system
# ENVOY_GATEWAY_ADDR=192.168.89.241:80
