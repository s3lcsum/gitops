# Phase Console — bootstrap only. Never imported into Phase itself.
# https://docs.phase.dev/self-hosting/configuration/envars
#
# Generate secrets: openssl rand -hex 32
# DB password: set once with ALTER USER phase_user — do NOT add a Vault static role.

HOST=phase.dominiksiejak.pl
HTTP_PROTOCOL=https://

NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
SECRET_KEY=replace-with-openssl-rand-hex-32
SERVER_SECRET=replace-with-openssl-rand-hex-32

SSO_PROVIDERS=authentik
ENABLE_PASSWORD_AUTH=true

AUTHENTIK_CLIENT_ID=phase
AUTHENTIK_CLIENT_SECRET=from-tofu-output-applications-phase-client_secret
AUTHENTIK_URL=https://auth.dominiksiejak.pl
AUTHENTIK_APP_SLUG=phase

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=phase_db
DATABASE_USER=phase_user
DATABASE_PASSWORD=set-once-with-alter-user

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
