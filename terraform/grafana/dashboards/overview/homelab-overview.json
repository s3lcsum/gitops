{
  "annotations": {
    "list": []
  },
  "description": "Scrape health, HTTP probes, cluster, n8n, media. Datasource VictoriaMetrics via PDC.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "count(max_over_time(up[15m]) == 0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Scrape targets down",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "count(max_over_time(probe_success[15m]) == 0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "HTTP probes down",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Pods not running",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "down"
                },
                "1": {
                  "color": "green",
                  "text": "up"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "max(max_over_time(up{job=\"n8n\"}[15m]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "n8n up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
