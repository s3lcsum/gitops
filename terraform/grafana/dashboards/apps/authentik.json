        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(authentik_main_request_duration_seconds_bucket[15m])))",
