{
  "annotations": {
    "list": []
  },
  "description": "Authentik request latency, workers, outposts, queued tasks.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(authentik_outposts_connected[15m]))",
          "refId": "A"
        }
      ],
      "title": "Outposts connected",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(authentik_tasks_workers[15m]))",
          "refId": "A"
        }
      ],
      "title": "Workers",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(authentik_tasks_queued[15m]))",
          "refId": "A"
        }
      ],
      "title": "Tasks queued",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(authentik_main_request_duration_seconds_bucket[15m])))",
          "refId": "A"
        }
      ],
      "title": "Request p95",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum(rate(authentik_main_request_duration_seconds_count[15m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
