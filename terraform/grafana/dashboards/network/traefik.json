      "targets": [
        {
          "expr": "topk(15, sum by (service) (rate(traefik_service_requests_total[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Service request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
