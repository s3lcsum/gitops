# Prefer 1Password + ExternalSecret (see externalsecret-repo-creds.yaml.example).
# Fine-grained PAT: Contents Read on s3lcsum/gitops. Do NOT use a gho_ OAuth token.
# Until the PAT exists in 1Password (Servers / argocd-github), leave this unused —
# no live ExternalSecret is applied (would go Invalid / Degraded).
# Legacy: copy to repo-credentials.yaml (gitignored), fill PAT, then make creds.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-repo-creds-github
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repo-creds
type: Opaque
stringData:
  type: git
  url: https://github.com/s3lcsum/
  username: replace-with-github-username
  password: replace-with-github-pat
