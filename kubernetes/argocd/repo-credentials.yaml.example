# Copy to repo-credentials.yaml (gitignored), fill PAT, then:
#   make encrypt-creds   → commits as repo-credentials.enc.yaml (SOPS/age)
# Applied by `make bootstrap` / `make creds` (decrypts .enc.yaml; plaintext optional).
# Not a Helm template: an Application sync does not render or wipe it.
# Fine-grained PAT: Contents Read on s3lcsum/gitops.
# url is a prefix; it covers https://github.com/s3lcsum/gitops.git.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-repo-creds-github
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repo-creds
type: Opaque
stringData:
  type: git
  url: https://github.com/s3lcsum/
  username: replace-with-github-username
  password: replace-with-github-pat
