# Legacy SOPS path (kept for decrypt-check / emergency). Live source is 1Password:
#   vault Servers / item argocd-oidc / field credential
# ExternalSecret templates/externalsecret-oidc.yaml merges into argocd-secret
# (creationPolicy: Merge — never kubectl-apply a Secret named argocd-secret).
# Value originally from: tofu output -raw 'applications.argocd.client_secret'
# in terraform/authentik.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-secret
  namespace: argocd
stringData:
  oidc.authentik.clientSecret: replace-with-tofu-output
