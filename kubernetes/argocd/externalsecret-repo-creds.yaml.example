# Example only — do NOT apply until a fine-grained GitHub PAT exists in 1Password.
# Create item Servers / argocd-github with fields:
#   username  — GitHub username (or any non-empty string; PAT auth ignores it)
#   credential — fine-grained PAT (Contents: Read on s3lcsum/gitops)
# Then copy this file to templates/externalsecret-repo-creds.yaml and sync.
# Helm must NOT own the resulting Secret; ExternalSecret creationPolicy Owner is fine
# because the Secret name is not chart-managed.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: argocd-repo-creds-github
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-repo-creds-github
    app.kubernetes.io/part-of: argocd
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: onepassword
    kind: ClusterSecretStore
  target:
    name: argocd-repo-creds-github
    creationPolicy: Owner
    template:
      engineVersion: v2
      metadata:
        labels:
          argocd.argoproj.io/secret-type: repo-creds
      data:
        type: git
        url: https://github.com/s3lcsum/
        username: "{{ .username }}"
        password: "{{ .password }}"
  data:
    - secretKey: username
      remoteRef:
        key: argocd-github/username
    - secretKey: password
      remoteRef:
        key: argocd-github/credential
