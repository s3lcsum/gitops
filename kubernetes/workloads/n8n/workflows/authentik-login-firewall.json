        "options": {
          "responseCode": 500
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"router error\" }"
      },
      "position": [
        1960,
        360
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    }
  ],
  "connections": {
