{
  "id": "w72dTPBXqHZKN1ip",
  "name": "WAN allowlist on login",
  "active": true,
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "parameters": {
        "httpMethod": "POST",
        "options": {},
        "path": "authentik-login",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "position": [
        200,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "63c51090-87d9-4f00-9c18-eec357240fba",
      "credentials": {
        "httpHeaderAuth": {
          "id": "58suiQVjjFvERDku",
          "name": "wan-allowlist"
        }
      }
    },
    {
      "id": "check-login-event",
      "name": "Check Login Event",
      "parameters": {
        "conditions": {
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.body.event?.action || $json.body.action }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "login"
            },
            {
              "leftValue": "={{ $json.body.event?.action || $json.body.action }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "authorize_application"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        }
      },
      "position": [
        640,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "compute-expiry",
      "name": "Compute Expiry",
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst event = body.event && typeof body.event === 'object' ? body.event : body;\nconst raw = String(event.client_ip || body.client_ip || '').trim();\nconst user = event.user?.username || event.user?.name || body.user?.username || 'unknown';\nconst ipv4Re = /^(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)$/;\nconst isPublicIpv4 = (value) => {\n  if (!value || value.includes(':')) return false;\n  if (!ipv4Re.test(value)) return false;\n  const octets = value.split('.').map(Number);\n  if (octets.some((o) => o > 255)) return false;\n  const [a, b] = octets;\n  if (a === 10 || a === 0 || a === 127) return false;\n  if (a === 169 && b === 254) return false;\n  if (a === 172 && b >= 16 && b <= 31) return false;\n  if (a === 192 && b === 168) return false;\n  if (a === 100 && b >= 64 && b <= 127) return false;\n  if (a >= 224) return false;\n  return true;\n};\nconst ip = isPublicIpv4(raw) ? raw : '';\nconst valid = ip !== '';\nconst ttlMs = 7 * 24 * 60 * 60 * 1000;\nconst now = Date.now();\nconst expiresMs = now + ttlMs;\nconst apiUrl = 'https://192.168.89.1/rest/ip/firewall/address-list/add';\nreturn [{ json: { ip, valid, user, raw_client_ip: raw, expires_ms: expiresMs, expires_iso: new Date(expiresMs).toISOString(), api_url: apiUrl, list_name: 'allowed-wan' } }];"
      },
      "position": [
        860,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "validate-ip",
      "name": "Validate IP",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "valid-ipv4",
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        1080,
        200
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "put-routeros",
      "name": "PUT to RouterOS",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "jsonBody": "={ \"address\": \"{{ $json.ip }}\", \"list\": \"allowed-wan\", \"comment\": \"ttl:{{ $json.expires_ms }}\", \"disabled\": false }",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "={{ $json.api_url }}"
      },
      "position": [
        1740,
        120
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpBasicAuth": {
          "id": "eTkZPZyTIeqFEZyR",
          "name": "RouterOS n8n-admin"
        }
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"ip\": \"{{ $node[\"Compute Expiry\"].json.ip }}\", \"user\": \"{{ $node[\"Compute Expiry\"].json.user }}\", \"expires\": \"{{ $node[\"Compute Expiry\"].json.expires_iso }}\" }"
      },
      "position": [
        1960,
        120
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-not-login",
      "name": "Respond Not Login",
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"skipped\": true }"
      },
      "position": [
        860,
        450
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-bad-ip",
      "name": "Respond Bad IP",
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"detail\": \"public IPv4 required (Cloudflare IPv6 is ignored)\", \"client_ip\": \"{{ $node[\"Compute Expiry\"].json.raw_client_ip }}\" }"
      },
      "position": [
        1300,
        360
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
