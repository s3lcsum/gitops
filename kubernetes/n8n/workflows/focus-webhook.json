    {
      "id": "focus-on-plan",
      "name": "Plan Immediate On",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        -384
      ],
      "parameters": {
        "jsCode": "const route = $('Route Focus Event').first().json;\nconst row = $('Get Controller (Focus)').first().json;\nconst prep = $('Prepare OverHours Context').first().json;\nconst entry = prep.current && prep.current.id ? prep.current : null;\nconst has = !!(entry && entry.id);\nconst workspace_id = Number(route.workspace_id || prep.workspace_id || 3825058);\nconst target = route.target || { project_id: Number(route.inpost_project_id || 215500877), description: 'Work' };\nlet project_id = Number(target.project_id);\nlet description = String(target.description || route.focus || 'Work');\nconst INPOST = Number(prep.inpost_project_id || 215500877);\nconst THRESHOLD = 8 * 3600;\nconst OH_DESC = 'Work OverHours';\n\nlet oh_tag_id = null;\ntry {\n  const ensured = $('Ensure OH Tag').first().json;\n  if (ensured && ensured.oh_tag_id) oh_tag_id = Number(ensured.oh_tag_id);\n} catch (e) {}\ntry {\n  if (!oh_tag_id) {\n    const created = $('Create OH Tag').first().json;\n    if (created && created.id) oh_tag_id = Number(created.id);\n  }\n} catch (e) {}\n\nfunction clampOverlapSec(startIso, stopIso, winStart, winEnd, nowMs) {\n  const start = Date.parse(startIso);\n  if (!Number.isFinite(start)) return 0;\n  let end = stopIso ? Date.parse(stopIso) : nowMs;\n  if (!Number.isFinite(end)) end = nowMs;\n  const a = Math.max(start, winStart);\n  const b = Math.min(end, winEnd);\n  return Math.max(0, Math.floor((b - a) / 1000));\n}\n\nlet tag_ids = [];\nif (route.focus === 'Work' && project_id === INPOST) {\n  const entries = Array.isArray($('Normalize Day Entries').first().json.day_entries) ? $('Normalize Day Entries').first().json.day_entries : [];\n  const nowMs = Date.now();\n  const winStart = Number(prep.window_start_ms);\n  const winEnd = Number(prep.window_end_ms);\n  let sum = 0;\n  const seen = new Set();\n  for (const e of entries) {\n    if (Number(e.project_id || 0) !== INPOST) continue;\n    seen.add(String(e.id));\n    const stop = e.stop || (e.duration >= 0 ? e.stop : null);\n    const running = !e.stop && Number(e.duration) < 0;\n    sum += clampOverlapSec(e.start, running ? null : e.stop, winStart, winEnd, nowMs);\n  }\n  if (has && Number(entry.project_id || 0) === INPOST && !seen.has(String(entry.id))) {\n    sum += clampOverlapSec(entry.start, null, winStart, winEnd, nowMs);\n  }\n  if (prep.before_7am || sum >= THRESHOLD) {\n    description = OH_DESC;\n    if (oh_tag_id) tag_ids = [oh_tag_id];\n  } else {\n    description = 'Work';\n  }\n}\n\nconst curPid = has ? Number(entry.project_id || 0) : 0;\nconst curDesc = has ? String(entry.description || '') : '';\nconst matches = has && curPid === project_id && curDesc === description;\nconst need_stop = has && !matches;\n\nconst RESUME_MS = 5 * 60 * 1000;\nconst lastStoppedAt = row.last_timer_stopped_at ? Date.parse(row.last_timer_stopped_at) : 0;\nconst lastPid = Number(row.last_timer_project_id || 0);\nconst lastDesc = String(row.last_timer_description || '');\nconst lastEntryId = row.last_timer_entry_id ? String(row.last_timer_entry_id) : '';\nconst lastStart = row.last_timer_start ? String(row.last_timer_start) : '';\nconst canResume = !matches\n  && !!lastEntryId\n  && !!lastStart\n  && lastPid === project_id\n  && lastDesc === description\n  && lastStoppedAt\n  && (Date.now() - lastStoppedAt) < RESUME_MS;\n\nconst need_resume = canResume;\nconst need_start = !matches;\nconst start_iso = need_resume ? lastStart : new Date().toISOString();\n\nconst remember_stop = need_stop;\nconst remember_entry_id = remember_stop ? String(entry.id) : null;\nconst remember_start = remember_stop ? String(entry.start || '') : null;\nconst remember_project_id = remember_stop ? curPid : null;\nconst remember_description = remember_stop ? curDesc : null;\n\nreturn [{ json: {\n  desired: true,\n  need_stop,\n  need_start,\n  need_resume,\n  need_focus: !!route.need_focus,\n  shortcut: route.shortcut || 'Set Work Focus',\n  stop_id: need_stop ? entry.id : null,\n  stop_wid: need_stop ? (entry.workspace_id || workspace_id) : null,\n  workspace_id,\n  project_id,\n  description,\n  tag_ids,\n  start_iso,\n  resume_delete_id: need_resume ? lastEntryId : null,\n  remember_stop,\n  remember_entry_id,\n  remember_start,\n  remember_project_id,\n  remember_description,\n  inpost_project_id: INPOST,\n  focus: route.focus,\n  suppress_until: new Date(Date.now() + 120000).toISOString(),\n  suppress_focus_until: route.need_focus\n    ? new Date(Date.now() + 120000).toISOString()\n    : (row.suppress_focus_until || null),\n  notes: `focus on focus=${route.focus} project=${project_id} desc=${description} tags=${tag_ids.join(',')} stop=${need_stop} start=${need_start} resume=${need_resume} need_focus=${!!route.need_focus}`\n}}];"
      }
