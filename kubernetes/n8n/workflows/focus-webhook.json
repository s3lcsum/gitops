    {
      "id": "focus-oh-prepare",
      "name": "Prepare OverHours Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -384
      ],
      "parameters": {
        "jsCode": "const curRaw = $input.first().json;\nconst current = curRaw && curRaw.id ? curRaw : (curRaw && curRaw.data && curRaw.data.id ? curRaw.data : null);\nconst route = $('Route Focus Event').first().json;\nconst TZ = 'Europe/Warsaw';\nconst INPOST = Number(route.inpost_project_id || 215500877);\n\nfunction warsawParts(date) {\n  const parts = new Intl.DateTimeFormat('en-GB', {\n    timeZone: TZ,\n    year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: '2-digit', minute: '2-digit', second: '2-digit',\n    hour12: false,\n  }).formatToParts(date);\n  const g = (t) => {\n    const v = parts.find((p) => p.type === t)?.value || '0';\n    return Number(v === '24' ? '0' : v);\n  };\n  return { y: g('year'), m: g('month'), d: g('day'), H: g('hour'), M: g('minute'), S: g('second') };\n}\n\nfunction warsawLocalToUtcMs(y, m, d, H = 0, M = 0, S = 0) {\n  let utc = Date.UTC(y, m - 1, d, H, M, S);\n  for (let i = 0; i < 4; i++) {\n    const p = warsawParts(new Date(utc));\n    const asUtc = Date.UTC(p.y, p.m - 1, p.d, p.H, p.M, p.S);\n    const target = Date.UTC(y, m - 1, d, H, M, S);\n    utc += target - asUtc;\n  }\n  return utc;\n}\n\nfunction addWarsawDays(y, m, d, days) {\n  const noon = warsawLocalToUtcMs(y, m, d, 12, 0, 0) + days * 24 * 3600 * 1000;\n  const p = warsawParts(new Date(noon));\n  return [p.y, p.m, p.d];\n}\n\nconst now = new Date();\nconst p = warsawParts(now);\nconst before_7am = p.H < 7;\nlet wy = p.y, wm = p.m, wd = p.d;\nif (before_7am) {\n  [wy, wm, wd] = addWarsawDays(p.y, p.m, p.d, -1);\n}\nconst windowStartMs = warsawLocalToUtcMs(wy, wm, wd, 7, 0, 0);\nconst [ey, em, ed] = addWarsawDays(wy, wm, wd, 1);\nconst windowEndMs = warsawLocalToUtcMs(ey, em, ed, 7, 0, 0);\n\nreturn [{ json: {\n  current,\n  focus: route.focus,\n  is_work: route.focus === 'Work',\n  before_7am,\n  window_start_iso: new Date(windowStartMs).toISOString(),\n  window_end_iso: new Date(windowEndMs).toISOString(),\n  window_start_ms: windowStartMs,\n  window_end_ms: windowEndMs,\n  inpost_project_id: INPOST,\n  workspace_id: Number(route.workspace_id || 3825058),\n}}];"
      }
    },
