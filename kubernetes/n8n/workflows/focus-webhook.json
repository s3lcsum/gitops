      "parameters": {
        "jsCode": "const event = $('Normalize Focus Event').first().json;\nconst row = $input.first().json;\nconst now = Date.now();\nconst suppressUntil = row.suppress_focus_until ? Date.parse(row.suppress_focus_until) : 0;\n// Only suppress Work echoes from our own SSH Set/Clear shortcuts.\nif (event.focus === 'Work' && suppressUntil && now < suppressUntil) {\n  return [{ json: {\n    skip: true,\n    reason: 'suppress_own_focus',\n    desired: event.desired,\n    focus: event.focus,\n    suppress_focus_until: row.suppress_focus_until\n  }}];\n}\n\nconst current = !!row.work_active;\nconst wantOn = event.desired === 'on';\nconst isWork = event.focus === 'Work';\nconst need_focus = isWork ? !current : (!wantOn && current);\n\nreturn [{ json: {\n  skip: false,\n  desired: event.desired,\n  focus: event.focus,\n  target: event.target,\n  need_focus,\n  shortcut: need_focus ? (isWork ? 'Set Work Focus' : 'Clear Work Focus') : '',\n  workspace_id: Number(row.workspace_id || 3825058),\n  inpost_project_id: Number(row.inpost_project_id || 215500877),\n  received_at: event.received_at,\n  focus_pending_desired: '',\n  focus_pending_since: null\n}}];"
