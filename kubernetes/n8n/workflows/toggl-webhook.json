    {
      "id": "ab8973ba-ae7b-5f9c-b8bc-daec6a99f527",
      "name": "Parse Toggl Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        460
      ],
      "parameters": {
        "jsCode": "const event = $input.first().json.event || {};\nconst action = String(event.metadata?.action || event.action || '').toLowerCase();\nlet payload = event.payload;\nif (typeof payload === 'string') {\n  try { payload = JSON.parse(payload); } catch (e) { payload = {}; }\n}\npayload = payload && typeof payload === 'object' ? payload : {};\nconst projectId = Number(payload.project_id || 0);\nconst inpostId = 215500877;\nconst workspaceId = Number(payload.workspace_id || 3825058);\nconst duration = Number(payload.duration);\nconst isRunning = duration < 0 || (!payload.stop && payload.start);\nconst isInPost = projectId === inpostId;\nconst deleted = action.includes('delet') || !!payload.server_deleted_at;\nlet workDesired = null;\nif (isInPost && !deleted && isRunning) workDesired = true;\nif (isInPost && (deleted || (!isRunning && payload.stop))) workDesired = false;\nreturn [{ json: {\n  action, projectId, inpostId, workspaceId, isRunning, isInPost, deleted,\n  workDesired, relevant: workDesired !== null,\n  entryId: String(payload.id || ''),\n  description: payload.description || '',\n  received_at: new Date().toISOString(),\n  source: 'toggl'\n} }];"
      }
    },
