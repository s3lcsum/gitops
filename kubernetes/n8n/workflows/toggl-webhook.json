    {
      "id": "36e2c9f2-0019-5f3c-a1b3-835d651eb1df",
      "name": "Decide Toggl Apply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        400
      ],
      "parameters": {
        "jsCode": "const evt = $('Parse Toggl Event').first().json;\nconst row = $input.first().json;\nconst now = Date.now();\nconst suppressUntil = row.suppress_toggl_until ? Date.parse(row.suppress_toggl_until) : 0;\nif (suppressUntil && now < suppressUntil) {\n  return [{ json: { skip: true, reason: 'suppress_own_toggl', workDesired: evt.workDesired } }];\n}\nconst desired = !!evt.workDesired;\n// Toggl→Focus SSH disabled; only update work_active state\nreturn [{ json: {\n  skip: false,\n  desired,\n  focus_pending_desired: '',\n  focus_pending_since: null,\n  work_active: desired,\n  last_source: 'toggl',\n  last_event_at: evt.received_at,\n  last_inpost_entry_id: evt.entryId || row.last_inpost_entry_id,\n  suppress_focus_until: row.suppress_focus_until || null,\n  notes: `toggl set work=${desired} entry=${evt.entryId}`\n} }];"
      }
    },
