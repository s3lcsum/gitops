    {
      "id": "toggl-merge-secret",
      "name": "Attach Toggl Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ],
      "parameters": {
        "jsCode": "const webhook = $('Toggl Webhook').first();\nconst secretRow = $input.first().json;\nconst out = Object.assign({}, webhook.json, {\n  toggl_secret: String(secretRow.value || '').trim(),\n  expected_callback: 'https://n8n.dominiksiejak.pl/webhook/toggl-time-entry'\n});\nconst item = { json: out };\nif (webhook.binary) item.binary = webhook.binary;\nreturn [item];"
      }
    },
    {
      "id": "toggl-verify-hmac",
      "name": "Verify Toggl HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        420
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst j = item.json;\nconst secret = String(j.toggl_secret || '').trim();\nconst headers = j.headers || {};\nconst sigHeader = String(headers['x-webhook-signature-256'] || headers['X-Webhook-Signature-256'] || '').trim();\n\n// Prefer full unparsed raw body bytes from webhook binary (rawBody: true).\n// Do NOT JSON.stringify(parsed body) — key order breaks Toggl HMAC.\n// Docs: https://engineering.toggl.com/docs/track/webhooks_start/validating_received_events/\nlet rawBuf = null;\nlet rawSource = 'none';\nif (item.binary && item.binary.data) {\n  try {\n    rawBuf = await this.helpers.getBinaryDataBuffer(0, 'data');\n    rawSource = 'binary';\n  } catch (e) {\n    const bin = item.binary.data;\n    rawBuf = Buffer.from(bin.data, bin.encoding || 'base64');\n    rawSource = 'binary_fallback';\n  }\n} else if (typeof j.body === 'string') {\n  rawBuf = Buffer.from(j.body, 'utf8');\n  rawSource = 'body_string';\n}\n\nlet ok = false;\nconst raw = rawBuf ? rawBuf.toString('utf8') : '';\nif (rawBuf && secret && sigHeader) {\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(rawBuf).digest('hex');\n  try {\n    const a = Buffer.from(expected);\n    const b = Buffer.from(sigHeader);\n    ok = a.length === b.length && crypto.timingSafeEqual(a, b);\n  } catch (e) {\n    ok = false;\n  }\n}\n\nlet parsed = {};\ntry {\n  parsed = raw ? JSON.parse(raw) : {};\n} catch (e) {\n  parsed = {};\n}\nconst payload = parsed.payload;\nconst validation_code = parsed.validation_code\n  || (payload && typeof payload === 'object' ? payload.validation_code : null)\n  || null;\nconst is_ping = payload === 'ping' || parsed.payload === 'ping' || !!validation_code;\n\nreturn [{ json: {\n  auth_ok: ok,\n  hmac_ok_strict: ok,\n  signature: sigHeader,\n  raw_len: rawBuf ? rawBuf.length : 0,\n  raw_source: rawSource,\n  event: parsed,\n  validation_code,\n  is_ping,\n  expected_callback: j.expected_callback || 'https://n8n.dominiksiejak.pl/webhook/toggl-time-entry',\n  url_callback: parsed.url_callback || ''\n} }];"
      }
    },
