# Bootstrap only. After the ClusterSecretStore is Ready, ExternalSecret
# templates/externalsecret-onepassword.yaml refreshes this Secret from
# Servers / k8s-external-secrets / credential.
# Copy to onepassword.yaml (gitignored), paste the token, then:
#   kubectl --context k8s@lake apply -f kubernetes/external-secrets/onepassword.yaml
# Token format: ops_...
apiVersion: v1
kind: Secret
metadata:
  name: onepassword
  namespace: external-secrets
type: Opaque
stringData:
  token: replace-with-1password-service-account-token
