# Copy to onepassword.yaml (gitignored), paste the 1Password service account token, then:
#   kubectl --context k8s@lake apply -f kubernetes/external-secrets/onepassword.yaml
# Token format: ops_...
# ClusterSecretStore "onepassword" reads this Secret. Store vault is Servers.
apiVersion: v1
kind: Secret
metadata:
  name: onepassword
  namespace: external-secrets
type: Opaque
stringData:
  token: replace-with-1password-service-account-token
